# Copy jadi .env lalu isi. File .env TIDAK masuk git (sudah di .gitignore).
# CATATAN: verifikasi model ID & base URL dari dashboard provider masing-masing;
# kalau error "model not found", ganti nilainya di sini — tanpa sentuh kode.

ANTHROPIC_API_KEY=sk-ant-ganti-dengan-key-lu

# GLM (Zhipu / Z.ai) — endpoint OpenAI-compatible
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4/
GLM_MODEL=glm-5.3

# Kimi (Moonshot) — endpoint OpenAI-compatible
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3

# Helius — saldo wallet (whale tracker). KERANGKA: key urusan founder.
HELIUS_API_KEY=
