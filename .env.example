# Copy to .env and fill in. The .env file NEVER enters git (already gitignored).
# NOTE: verify model IDs & base URLs in each provider's dashboard;
# if you hit a "model not found" error, change the value here — no code edits needed.

ANTHROPIC_API_KEY=sk-ant-replace-with-your-key

# GLM (Zhipu / Z.ai) — OpenAI-compatible endpoint
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4/
GLM_MODEL=glm-5.3

# Kimi (Moonshot) — OpenAI-compatible endpoint
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3

# ── Provider-agnostic LLM (providers/llm.py — overrides per-provider vars above) ──
# LLM_PROVIDER: which LLM_CONFIGS entry to use (default: minimax).
LLM_PROVIDER=minimax
# LLM_BASE_URL: overrides the provider's default base URL (empty = dict default).
LLM_BASE_URL=
# LLM_API_KEY: auth key sent in the SDK header — never a URL or query string.
LLM_API_KEY=
# LLM_MODEL: overrides the provider's default model id (empty = dict default).
LLM_MODEL=

# ── VILMEI AI (PROMPT-AI-V) — NVIDIA NIM free tier (webapp/ai_ask.py) ──────
# NVIDIA_API_KEY: build.nvidia.com / integrate.api.nvidia.com key. Paste it
# HERE (in .env, via a text editor) — never into chat, never into git. Unset
# = the AI surfaces degrade with an honest 503 sentence; the rest of the
# terminal stays live. Limit is a BUDGET (RPM + daily pool), not credits.
NVIDIA_API_KEY=
# BAI_API_KEY: the Analyst chat lane (landing §06) — glm-5.3-flash via
# the OpenAI-compatible chat endpoint; key lives in the founder .env only.
BAI_API_KEY=
# VILMEI_AI_MODEL_FREE (V5-G2 routing): fast tier — reasoning off, ~900 tok,
# 10 s open budget + one FALLBACK shot, then the honest busy copy.
VILMEI_AI_MODEL_FREE=deepseek-ai/deepseek-v4-flash-0731
# VILMEI_AI_MODEL_DEEP: reasoning tier — one 25 s open, deep may be slow,
# free may not; a stall becomes an honest in-stream error (never a red wall).
VILMEI_AI_MODEL_DEEP=moonshotai/kimi-k3
# V5-G2 FREE-chain fallback (one more 10s shot before the honest busy copy)
VILMEI_AI_MODEL_FALLBACK=deepseek-ai/deepseek-v4-pro-0813
# VILMEI_AI_DAILY_MAX_QUESTIONS: the global daily pool shared by all visitors.
VILMEI_AI_DAILY_MAX_QUESTIONS=240

# Helius — wallet balances (whale tracker). FRAMEWORK: key is the founder's call.
HELIUS_API_KEY=

# Alchemy — PROMPT-V4 M5 holdings: bnb native+tokens, base primary (the keyless
# Blockscout fallback covers base when unset). FRAMEWORK: founder's call.
ALCHEMY_API_KEY=

# ── Web server (webapp/server.py) ──────────────────────────────────────────
# CORS_ALLOW_ORIGINS: comma list of FE origins allowed to call the API cross-origin.
CORS_ALLOW_ORIGINS=
# WS_AUTH_TOKEN: required ?token= for /ws/snap; empty = dev-open (logs a warning).
WS_AUTH_TOKEN=
# MAX_WS_CLIENTS: hard cap on concurrent /ws/snap sockets per process.
MAX_WS_CLIENTS=64

# ── PROMPT-V4 M3: fee vault destinations (docs/FEE-VAULTS.md) ─────────────
# PUBLIC ADDRESSES ONLY — the founder holds every vault key; a key NEVER
# enters this repo (claim-based). Unset = the slice renders
# 'awaiting-founder' on /api/v1/fees/destinations. Chains: SOL BNB BASE HYPE
# HOOD · slices: OPS BUYBACK REWARDS.
VAULT_SOL_OPS_ADDRESS=
VAULT_SOL_BUYBACK_ADDRESS=
VAULT_SOL_REWARDS_ADDRESS=
VAULT_BNB_OPS_ADDRESS=
VAULT_BNB_BUYBACK_ADDRESS=
VAULT_BNB_REWARDS_ADDRESS=
VAULT_BASE_OPS_ADDRESS=
VAULT_BASE_BUYBACK_ADDRESS=
VAULT_BASE_REWARDS_ADDRESS=
VAULT_HYPE_OPS_ADDRESS=
VAULT_HYPE_BUYBACK_ADDRESS=
VAULT_HYPE_REWARDS_ADDRESS=
VAULT_HOOD_OPS_ADDRESS=
VAULT_HOOD_BUYBACK_ADDRESS=
VAULT_HOOD_REWARDS_ADDRESS=

# ── T2 swap quotes (providers/swap_quotes.py) ─────────────────────────────
# Live quote-only via keyless providers (verified 2026-09-02: Jupiter
# lite-api.jup.ag HTTP 200, LI.FI li.quest HTTP 200). Execution stays OFF.
# VILMEI_SWAP_LIVE=0 disables live quoting (the test suite pins this).
# VILMEI_SWAP_KILL=1 is the global kill switch: circuit breaker + adapters
# refuse everything immediately, read at check time (no restart needed).
# VILMEI_SWAP_LIVE=1
# VILMEI_SWAP_KILL=0
# VILMEI_JUPITER_BASE=https://lite-api.jup.ag
# VILMEI_LIFI_BASE=https://li.quest
# VILMEI_SOLANA_RPC=https://api.mainnet-beta.solana.com
# VILMEI_SWAP_QUOTE_TIMEOUT_S=8
# VILMEI_SWAP_SHADOW_FILE=logs/swap_quotes.jsonl
# VILMEI_SWAP_EXEC_FILE=data/swap-executions.jsonl

# ── T2-E swap hardening (providers/simulation.py, swap_circuit_breaker.py,
#    webapp/swap_quote_state.py, webapp/swap_throttle.py) ──────────────────
# Simulation RPCs — ENV NAMES ONLY, no default URLs. A chain without its
# var set stays QUOTE_ONLY/UNAVAILABLE honestly (fail-closed), never "maybe
# it works". EVM chains use eth_simulateV1, Solana uses simulateTransaction.
# VILMEI_SIM_RPC_SOL=
# VILMEI_SIM_RPC_BNB=
# VILMEI_SIM_RPC_BASE=
# VILMEI_SIM_RPC_HYPE=
# VILMEI_SIM_RPC_HOOD=
# VILMEI_SIM_TIMEOUT_S=8
# Quote idempotency state (SQLite swap_quotes table; needs ALPHA_DB_PATH).
# TTL is the quote validity; a consumed/expired(+15s buffer) quote_id is
# refused with 409/410 instead of ever double-submitting.
# VILMEI_SWAP_QUOTE_TTL_S=60
# Quote throttle: requests/min per IP and per wallet on /api/v1/swap/quote
# (429 + Retry-After above the limit).
# VILMEI_SWAP_QUOTE_RPM=20
# Provider-quote cache TTL (10–15s) — damps identical fan-out; policy and
# simulation gates still run fresh on every request.
# VILMEI_SWAP_QUOTE_CACHE_TTL_S=12
